import java.util.Scanner;
class Main
{
  public static void main(String[] args)
  {
    Scanner kk = new Scanner(System.in);
    int n = kk.nextInt();
    int [] a = new int[n];
    for(int i=0;i<n;i++)
    {
      a[i] = kk.nextInt();
    }
    for(int i=1;i<=n;i++)
    {
      for(int j=1;j<=i;j++)
      {
        System.out.print(" *");
      }
    }
    System.out.println();
  }
}
