import java.util.Scanner;

class Main
{
    public static void main(String[] args)
    {
        Scanner kk = new Scanner(System.in);
        int n = kk.nextInt();
        for(int i = 1; i <= n; i++)
        {
            for(int s = 1; s <= n - i; s++)
            {
                System.out.print(" ");
            }
            for(int j = 1; j <= i; j++)
            {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}

