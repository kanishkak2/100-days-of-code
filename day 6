import java.util.Scanner;
class Main
{
  public static void mani(String[] args)
  {
    Scanner kk = new Scanner(System.in);
    int n = kk.nextInt();
    for(int i=0;i<n;i++)
    {
      for(int s=0;s<n-i-1;s++)
      {
        System.out.print(" ");
      }
      int nm = 1;
      for(int j=0;j<=i;j++)
      {
        System.out.print(nm+" ");
          nm = nm*(i-j)/(j+1);
      }
      System.out.println();
    }
  }
}
